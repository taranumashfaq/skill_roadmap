# Copy this file to ".env" and set your OpenAI API key.
# Do NOT commit your real .env to version control.
#
# The server will read either `OPENAI_API_KEY`, `OPEN_API_KEY`, or `open_api_key`.
# Use whichever name your tooling prefers. Example:

OPENAI_API_KEY=your_openai_api_key_here
# Alternatively (some tools use this name):
# OPEN_API_KEY=your_openai_api_key_here
# or lowercase form:
# open_api_key=your_openai_api_key_here
